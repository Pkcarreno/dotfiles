[user]
  email = 34664891+Pkcarreno@users.noreply.github.com
  name = Pedro Carreno

[core]
  fileMode = true
  editor = nvim
  ignoreCase = false
  autocrlf = false
  eol = lf
  pager = delta

[init]
  defaultBranch = main

[commit]
  verbose = true
  
[fetch]
  prune = true
  parallel = 3

[submodule]
  fetchJobs = 3

[pull]
  rebase = true

[push]
  default = simple
  autoSetupRemote = true
  followTags = yes

[help]
  autoCorrect = prompt

[color]
  status = auto
  diff = auto
  branch = auto
  interactive = auto
  grep = auto
  ui = auto

[alias]
  a = add
  aa = add --all
  b = branch
  ba = branch -a
  bm = branch --merged
  bnm = branch --no-merged
  c = commit -v
  co = checkout
  cob = checkout -b
  ca = commit -v -a
  cam = commit -v -a -m
  cmsg = commit -m
  cz = cz c
  d = diff
  dsw = diff --staged --word-diff
  ds = diff --staged
  f = fetch
  fa = fetch --all --prune --jobs=10
  hh = help
  hha = config --get-regexp ^alias\\.
  lg = log --stat
  lgp = log --stat -p
  lo = log --oneline --decorate
  loga = log --oneline --decorate --graph --all
  m = merge
  ma = merge --abort
  ps = push
  psd = push --dry-run
  psu = push upstream
  psv = push -v
  pl = pull
  plr = pull --rebase
  plra = pull --rebase --autostash
  plrav = pull --rebase --autostash -v
  plv = pull --rebase -v
  pristine = "!git reset --hard && git clean -dffx"
  r = remote
  ra = remote add
  rv = remote -v
  rev = revert
  rh = reset
  rhh = reset --hard
  rhs = "reset --soft HEAD^"
  rs = restore
  rss = restore --source
  rst = restore --staged
  st = status
  sts = status -s
  stb = status -sb
  sh = show
  sw = switch
  swc = switch -c

[interactive]
  diffFilter = delta --color-only

[diff]
  colorMove = default

[merge]
  conflictstyle = diff3

[blame]
  pager = delta

[rerere]
  enabled = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process

[include]
  path = config.delta
  path = config.private
